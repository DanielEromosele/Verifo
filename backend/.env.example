# Verifo backend configuration.
# Copy to .env and adjust. NEVER commit .env

# --- App ---
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
VERIFO_ENV=development

# --- Database ---
# Preferred: PostgreSQL. Leave empty to use SQLite.
# If a PostgreSQL URL is set but unreachable, Verifo falls back to SQLite
# automatically and logs a warning. Set VERIFO_FORCE_POSTGRES=1 to disable fallback.
DATABASE_URL=postgresql+psycopg2://verifo:verifo@localhost:5432/verifo
VERIFO_FORCE_POSTGRES=0

# --- Storage ---
# Root directory for uploaded files (relative to backend/ unless absolute).
VERIFO_STORAGE=storage
# 1 = PGP (Fernet) encrypt files at rest. Key must be in VERIFO_STORAGE_KEY.
VERIFO_STORAGE_ENCRYPT=0
VERIFO_STORAGE_KEY=

# --- Demo seeding ---
# 0 = bootstrap accounts only | 1 = full demo fixtures (references, counterfeits, samples)
SEED_SAMPLE=0

# --- Demo auth ---
# 1 = allow zero-credential /demologin (development only; never Production/Testing)
VERIFO_DEMO_AUTH=0
# Demo workspace account (created by `flask --app run.py seed-demo`)
#   admin@demo.edu   / verifo-demo-admin   (ADMIN)
#   operator@demo.edu / VerifoDemo123!     (OPERATOR)
#   student@demo.edu  / VerifoDemo123!     (SUBMITTER)

# --- Tokens / JWT ---
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
# Used to sign short-lived download URLs.
VERIFO_DOWNLOAD_SECRET=

# --- Worker (bulk screening queue) ---
# Run with: flask --app run.py run-worker
VERIFO_WORKER_CONCURRENCY=4
VERIFO_WORKER_POLL_INTERVAL=2
VERIFO_WORKER_MAX_RETRIES=2
# Empty REDIS_URL = in-process SQLite queue (default)
REDIS_URL=

# --- AI provider (optional) ---
# Empty = local heuristic pipeline (default)
AI_PROVIDER=local
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=